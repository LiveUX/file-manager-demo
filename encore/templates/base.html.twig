<!DOCTYPE html>
<html lang="{{ activeLocale|default('en') }}"
      dir="{{ (activeLocale|default('en')) == 'ar' ? 'rtl' : 'ltr' }}"
      {% if activeScheme|default('light') == 'dark' %}
          class="dark"
          data-bs-theme="dark"
          data-theme="dark"
      {% else %}
          data-bs-theme="light"
          data-theme="light"
      {% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}LiveUX FileManagerBundle — Symfony 8 Showcase{% endblock %}</title>
    <link rel="icon" type="image/webp" href="/images/liveux-logo.webp">

    {# Load REAL host CSS framework depending on active demo theme to prove zero-conflict compatibility #}
    {% if activeTheme|default('bootstrap5') == 'bootstrap5' %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    {% elseif activeTheme|default('') == 'daisyui' %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css">
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    {% elseif activeTheme|default('') in ['tailwind', 'shadcn', 'flowbite'] %}
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    {% endif %}

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="liveux-demo-body">
    <div class="liveux-demo-wrap">
        <header class="liveux-demo-nav">
            <a href="{{ path('demo_browser', { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}" class="liveux-demo-brand">
                <img src="/images/liveux-logo.webp" alt="LiveUX for Symfony">
                <div>
                    <div class="liveux-demo-brand-title">LiveUX FileManagerBundle</div>
                    <div class="liveux-demo-brand-sub">Symfony 8.1 • Webpack Encore • Zero CSS Framework Dependency</div>
                </div>
            </a>

            <nav class="liveux-demo-links">
                <a class="liveux-demo-link {{ activePage == 'browser' ? 'is-active' : '' }}"
                   href="{{ path('demo_browser', { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}">Inline Browser</a>
                <a class="liveux-demo-link {{ activePage == 'forms' ? 'is-active' : '' }}"
                   href="{{ path('demo_forms', { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}">FormType</a>
                <a class="liveux-demo-link {{ activePage == 'collections' ? 'is-active' : '' }}"
                   href="{{ path('demo_collections', { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}">Collection &amp; LiveCollection</a>
                <a class="liveux-demo-link {{ activePage == 'editors' ? 'is-active' : '' }}"
                   href="{{ path('demo_editors', { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}">WYSIWYG Editors</a>
                <a class="liveux-demo-link {{ activePage == 'modals' ? 'is-active' : '' }}"
                   href="{{ path('demo_modals', { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}">Modal &amp; OffCanvas</a>
                <a class="liveux-demo-link"
                   href="/admin">EasyAdmin 5</a>
            </nav>
        </header>

        <section class="liveux-demo-controls">
            <span class="liveux-demo-ctrl-label">Theme</span>
            <div class="liveux-demo-pills">
                {% for t in themes %}
                    <a class="liveux-demo-pill {{ activeTheme == t ? 'is-active' : '' }}"
                       href="{{ path('demo_' ~ activePage, { theme: t, icon_set: activeIconSet, locale: activeLocale, scheme: activeScheme }) }}">{{ t }}</a>
                {% endfor %}
            </div>

            <span class="liveux-demo-ctrl-label" style="margin-inline-start: 8px;">Icons</span>
            <div class="liveux-demo-pills">
                {% for ic in iconSets %}
                    <a class="liveux-demo-pill {{ activeIconSet == ic ? 'is-active' : '' }}"
                       href="{{ path('demo_' ~ activePage, { theme: activeTheme, icon_set: ic, locale: activeLocale, scheme: activeScheme }) }}">{{ ic }}</a>
                {% endfor %}
            </div>

            <span class="liveux-demo-ctrl-label" style="margin-inline-start: 8px;">Locale</span>
            <div class="liveux-demo-pills">
                {% for loc in locales %}
                    <a class="liveux-demo-pill {{ activeLocale == loc ? 'is-active' : '' }}"
                       href="{{ path('demo_' ~ activePage, { theme: activeTheme, icon_set: activeIconSet, locale: loc, scheme: activeScheme }) }}">{{ loc|upper }}</a>
                {% endfor %}
            </div>

            <span class="liveux-demo-ctrl-label" style="margin-inline-start: 8px;">Mode</span>
            <div class="liveux-demo-pills">
                <a class="liveux-demo-pill {{ activeScheme == 'light' ? 'is-active' : '' }}"
                   href="{{ path('demo_' ~ activePage, { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: 'light' }) }}">☀ Light</a>
                <a class="liveux-demo-pill {{ activeScheme == 'dark' ? 'is-active' : '' }}"
                   href="{{ path('demo_' ~ activePage, { theme: activeTheme, icon_set: activeIconSet, locale: activeLocale, scheme: 'dark' }) }}">🌙 Dark</a>
            </div>
        </section>

        <main>
            {% block body %}{% endblock %}
        </main>
    </div>
</body>
</html>
